# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id. Leave empty on first run, message the bot /start, and it will tell you.
TELEGRAM_OWNER_ID=

# --- Schedule (local time in TZ) ---
TZ=Europe/Berlin
MORNING_TIME=08:15
EVENING_TIME=17:45

# --- Google Health (Desktop OAuth client) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Space-separated. Defaults shown; adjust after checking the Google Health API docs.
GOOGLE_SCOPES=https://www.googleapis.com/auth/googlehealth.sleep.readonly https://www.googleapis.com/auth/googlehealth.health_metrics_and_measurements.readonly
GOOGLE_HEALTH_BASE_URL=https://health.googleapis.com/v4
# dataType ids as used in the v4 URL path; confirm with `python probe.py`
GH_TYPE_SLEEP=sleep
GH_TYPE_RHR=daily-resting-heart-rate
GH_TYPE_HRV=daily-heart-rate-variability

# --- LLM extraction + brief (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Voice notes (Whisper via OpenAI API) ---
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# --- Storage ---
DB_PATH=data/vitals.db
GOOGLE_TOKEN_PATH=data/google_token.json
